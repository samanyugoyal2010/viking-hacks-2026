OPENROUTER_API_KEY=
# Create a key at https://openrouter.ai/keys

# Optional: public site URL (custom domain on Vercel). Used for OpenRouter HTTP-Referer when VERCEL_URL is not set.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: override OpenRouter referer (defaults: VERCEL_URL in production, localhost in dev)
# OPENROUTER_HTTP_REFERER=https://your-domain.com

# Optional: dedicated key for /image image generation (falls back to OPENROUTER_API_KEY if unset)
# OPENROUTER_IMAGE_API_KEY=

# Optional: override chat model (default: nvidia/nemotron-nano-12b-v2-vl:free)
# OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# /image — image model on OpenRouter (default: sourceful/riverflow-v2-pro)
# OPENROUTER_IMAGE_MODEL=sourceful/riverflow-v2-pro
