OPENROUTER_API_KEY=
# Create a key at https://openrouter.ai/keys

# Optional: override chat model (default: nvidia/nemotron-nano-12b-v2-vl:free)
# OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# /image: if OPENAI_API_KEY is set, images are generated with OpenAI (default gpt-image-1.5).
# Otherwise images use OpenRouter (default: sourceful/riverflow-v2-pro).
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5-2025-12-16

# Optional when not using OpenAI for images:
# OPENROUTER_IMAGE_MODEL=sourceful/riverflow-v2-pro
