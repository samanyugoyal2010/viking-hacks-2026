# Copy to .env.local (never commit .env.local).

# --- Option A: OpenAI directly ---
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Optional: custom base (proxies) or model
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- Option B: OpenRouter (OpenAI-compatible API; use if OpenAI key fails or you prefer one bill) ---
# https://openrouter.ai/keys — create a key; pick a vision-capable model id.
OPENROUTER_API_KEY=sk-or-v1-...
# Default in code if unset: nvidia/nemotron-nano-12b-v2-vl:free (vision + text)
# OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Site URL for OpenRouter rankings (defaults to localhost or Vercel URL)
# OPENROUTER_HTTP_REFERER=https://your-app.vercel.app

# If both OPENROUTER_API_KEY and OPENAI_API_KEY are set, OpenRouter is used first.
